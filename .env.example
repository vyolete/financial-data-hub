# Copy to .env (ignored by Git) and set a local password. No real values here.
POSTGRES_PASSWORD=
# Optional Socrata application token, sent only to the configured hosts. Never commit a value.
# FDH_SOCRATA_APP_TOKEN=
# Optional: change only if a port is already in use. Services stay on 127.0.0.1.
# FDH_DB_PORT=5432
# FDH_API_PORT=8000
# FDH_WEB_PORT=8080
